DATABASE_URL=postgres://user:password@localhost:5432/ravanagems
AUTH_SECRET=generate-with-npx-auth-secret

# File storage: "local" (default, writes to public/uploads) or "s3"
STORAGE_DRIVER=local
# Required only when STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, Backblaze B2, ...)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=

# KYC verification: "mock" (default, dev — simulates vendor review in the UI)
# or "sumsub" (production, once you have a Sumsub business account)
KYC_PROVIDER=mock
# Required only when KYC_PROVIDER=sumsub
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level
